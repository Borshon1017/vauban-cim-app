# Copy to .env and fill in (Supabase → Project Settings → API).
# Use the "anon" / "publishable" key ONLY. Never the service_role / secret key.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Optional: the "Ask the map" assistant (agent/ folder). Leave empty to hide the chat button.
VITE_AGENT_URL=http://localhost:8000
