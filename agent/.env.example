# Copy to agent/.env for local runs. On the server, set these as secret environment variables instead.
MISTRAL_API_KEY=
# ministral-14b is the strongest model the free plan serves with tool calling (about 0.5 requests a second,
# hence the pause between calls). On a paid plan, try mistral-small-latest and MISTRAL_MIN_INTERVAL_S=0.
MISTRAL_MODEL=ministral-14b-2512
MISTRAL_MIN_INTERVAL_S=2.1
MISTRAL_EMBED_MODEL=mistral-embed

# The same PUBLIC values as the web app (VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY). Never the service_role key.
SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-KEY

# The web app's address(es), comma separated
ALLOWED_ORIGINS=http://localhost:5173

# Limits for the public endpoint (each question costs one or more LLM calls)
RATE_PER_MINUTE=6
RATE_PER_DAY=60
DAILY_BUDGET=2000
